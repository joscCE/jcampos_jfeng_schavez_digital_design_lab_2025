
module debounce(
    input clk,       
    input pb_1,      
    output pb_out    
);

    reg [17:0] counter = 0; // 18 bits para contar hasta 250,000 (25Mhz * 10ms)
    reg slow_clk = 0;

    // generar un pulso lento cada 10ms
    always @(posedge clk) begin
        if (counter >= 249_999)
            counter <= 0;
        else
            counter <= counter + 1;

        slow_clk <= (counter < 125_000) ? 1'b0 : 1'b1;
    end

    // Flip-flops sincronizados al slow_clk
    reg Q0 = 0, Q1 = 0, Q2 = 0;

    always @(posedge slow_clk) begin
        Q0 <= pb_1;
        Q1 <= Q0;
        Q2 <= Q1;
    end

    //assign pb_out = Q1 & ~Q2;
	 assign pb_out = Q1;

endmodule
